APP_NAME="AI Fintech Intelligence Platform"
APP_VERSION="0.1.0"
DEBUG=True
ENVIRONMENT=development
DATABASE_URL=postgresql://postgres:password@localhost:5432/ai_fintech_db
CREATE_DATABASE_TABLES=False
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama3-70b-8192
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
MAX_UPLOAD_SIZE_MB=10
MAX_CV_PAGES=100
MAX_CV_TEXT_CHARACTERS=500000
MAX_DOCX_UNCOMPRESSED_MB=50

# Password-reset email delivery
FRONTEND_URL=http://localhost:5174
PASSWORD_RESET_EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME="JustCorp Talent AI"
SMTP_USE_TLS=true
SMTP_TIMEOUT_SECONDS=15
